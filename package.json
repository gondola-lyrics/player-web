{
  "name": "@gondola-lyrics/player",
  "version": "0.0.0",
  "description": "Gondola lyrics player for the web",
  "keywords": [
    "gondola",
    "lyrics",
    "lyric",
    "karaoke",
    "player",
    "web"
  ],
  "license": "MIT",
  "author": "folltoshe",
  "homepage": "https://github.com/gondola-lyrics/player-web#readme",
  "bugs": {
    "url": "https://github.com/gondola-lyrics/player-web/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gondola-lyrics/player-web.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "build-change-log": "tsx script/build-change-log.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src script"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@gondola-lyrics/model": "^1.1.0"
  },
  "dependencies": {
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@gondola-lyrics/model": "1.1.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "26.4.1",
    "@types/semver": "7.7.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.1.0"
  }
}

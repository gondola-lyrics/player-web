{
  "name": "@gondola-lyrics/player-playground",
  "version": "0.0.0",
  "description": "Gondola lyrics player playground",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "vue-tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@gondola-lyrics/kit": "0.7.0",
    "@gondola-lyrics/model": "2.0.0",
    "naive-ui": "2.45.3",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@vitejs/plugin-vue": "6.0.11",
    "prettier": "3.9.6",
    "sass": "1.108.2",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vue-tsc": "3.3.14"
  }
}
